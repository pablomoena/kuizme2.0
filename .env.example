# Copiar a .env.local y completar. Nunca commitear .env.local.

# Supabase — proyecto propio (NO Lovable Cloud)
NEXT_PUBLIC_SUPABASE_URL=https://bmsefapphatpqtufbife.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role: omite RLS. Solo en el servidor, solo en webhooks y jobs.
# En producción va en las variables de entorno de Vercel, no en un archivo.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio raíz. En desarrollo: localhost (usa ibmiel.localhost:3000 para probar
# un tenant). En producción: kuizme.com
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# Integraciones por tenant (D14) — la llave con la que se cifran los tokens de
# Zoom, Mercado Pago y compañía ANTES de guardarlos.
#
# La base NUNCA la ve: por eso un respaldo de Postgres, por sí solo, no entrega
# ningún token. Y por eso mismo, si esta llave se pierde hay que reconectar todas
# las integraciones — no hay forma de recuperar lo cifrado.
#
#   openssl rand -base64 32
#
# Tiene que ser base64 de 32 bytes exactos. Una frase corta se rechaza al
# arrancar: usada como llave daría 256 bits de los cuales la mitad son
# predecibles.
INTEGRATIONS_ENCRYPTION_KEY=

# Zoom — UNA app de Kuizme en el Marketplace, y cada institución conecta su
# cuenta. Nunca credenciales de app por institución (la v1 tiene columnas para
# eso y no las usa).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email transaccional
RESEND_API_KEY=

# Video
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_CDN_HOSTNAME=

# Pagos — fase 1: Mercado Pago Chile (split 1:1 con OAuth)
MERCADOPAGO_APP_ID=
MERCADOPAGO_APP_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=

# Pagos — suscripción SaaS
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
